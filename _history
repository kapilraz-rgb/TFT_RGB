{"entries":[{"timestamp":1792313923815,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":84,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":33,"diffs":[[1,"\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":204,"length1":41,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":231,"length1":75,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"},{"type":"added","filename":"custom.ts","value":"/**\n * Colors (Calibrated for BGR 1.8\" TFT Display)\n */\nenum Color {\n    //% block=\"Black\"\n    Black = 0x0000,\n    //% block=\"Navy\"\n    Navy = 0x000F,\n    //% block=\"DarkGreen\"\n    DarkGreen = 0x03E0,\n    //% block=\"DarkCyan\"\n    DarkCyan = 0x03EF,\n    //% block=\"Maroon\"\n    Maroon = 0x7800,\n    //% block=\"Purple\"\n    Purple = 0x780F,\n    //% block=\"Olive\"\n    Olive = 0x7BE0,\n    //% block=\"LightGrey\"\n    LightGrey = 0xC618,\n    //% block=\"DarkGrey\"\n    DarkGrey = 0x7BEF,\n    //% block=\"Blue\"\n    Blue = 0x001F,\n    //% block=\"Green\"\n    Green = 0x07E0,\n    //% block=\"Cyan\"\n    Cyan = 0x07FF,\n    //% block=\"Red\"\n    Red = 0xF800,\n    //% block=\"Magenta\"\n    Magenta = 0xF81F,\n    //% block=\"Yellow\"\n    Yellow = 0xFFE0,\n    //% block=\"White\"\n    White = 0xFFFF,\n    //% block=\"Orange\"\n    Orange = 0xFD20,\n    //% block=\"GreenYellow\"\n    GreenYellow = 0xAFE5,\n    //% block=\"Pink\"\n    Pink = 0xFA3A\n}\n\n/**\n  * Custom 1.8 TFT Fixed Extension\n  */\n//% color=\"#1D6375\" icon=\"\" weight=95 block=\"TFT Fixed\"\nnamespace TFTFixed {\n    let TFTWIDTH = 130\n    let TFTHEIGHT = 162\n\n    enum TFTCommands {\n        NOP = 0x00,\n        SWRESET = 0x01,\n        SLPOUT = 0x11,\n        NORON = 0x13,\n        INVOFF = 0x20,\n        DISPOFF = 0x28,\n        DISPON = 0x29,\n        CASET = 0x2A,\n        RASET = 0x2B,\n        RAMWR = 0x2C,\n        MADCTL = 0x36,\n        COLMOD = 0x3A,\n        FRMCTR1 = 0xB1,\n        FRMCTR2 = 0xB2,\n        FRMCTR3 = 0xB3,\n        INVCTR = 0xB4,\n        PWCTR1 = 0xC0,\n        PWCTR2 = 0xC1,\n        PWCTR3 = 0xC2,\n        PWCTR4 = 0xC3,\n        PWCTR5 = 0xC4,\n        VMCTR1 = 0xC5,\n        GMCTRP1 = 0xE0,\n        GMCTRN1 = 0xE1,\n        DELAY = 0xFFFF\n    }\n\n    let fontOne: number[] = [0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422]\n    let fontTwo: number[] = [0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x00000000, 0x000002e0, 0x00018060, 0x00afabea, 0x00aed6ea, 0x01991133, 0x010556aa, 0x00000060]\n    let fontThree: number[] = [0x000045c0, 0x00003a20, 0x00051140, 0x00023880, 0x00002200, 0x00021080, 0x00000100, 0x00111110, 0x0007462e, 0x00087e40, 0x000956b9, 0x0005d629, 0x008fa54c, 0x009ad6b7, 0x008ada88, 0x00119531, 0x00aad6aa, 0x0022b6a2, 0x00000140, 0x00002a00]\n    let fontFour: number[] = [0x0008a880, 0x00052940, 0x00022a20, 0x0022d422, 0x00e4d62e, 0x000f14be, 0x000556bf, 0x0008c62e, 0x0007463f, 0x0008d6bf, 0x000094bf, 0x00cac62e, 0x000f909f, 0x000047f1, 0x0017c629, 0x0008a89f, 0x0008421f, 0x01f1105f, 0x01f4105f, 0x0007462e]\n    let fontFive: number[] = [0x000114bf, 0x000b6526, 0x010514bf, 0x0004d6b2, 0x0010fc21, 0x0007c20f, 0x00744107, 0x01f4111f, 0x000d909b, 0x00117041, 0x0008ceb9, 0x0008c7e0, 0x01041041, 0x000fc620, 0x00010440, 0x01084210, 0x00000820, 0x010f4a4c, 0x0004529f, 0x00094a4c]\n    let fontSix: number[] = [0x000fd288, 0x000956ae, 0x000097c4, 0x0007d6a2, 0x000c109f, 0x000003a0, 0x0006c200, 0x0008289f, 0x000841e0, 0x01e1105e, 0x000e085e, 0x00064a4c, 0x0002295e, 0x000f2944, 0x0001085c, 0x00012a90, 0x010a51e0, 0x010f420e, 0x00644106, 0x01e8221e]\n    let fontSeven: number[] = [0x00093192, 0x00222292, 0x00095b52, 0x0008fc80, 0x000003e0, 0x000013f1, 0x00841080, 0x0022d422];\n\n    function send(command: TFTCommands, parameter: Array<number>): void {\n        pins.digitalWritePin(DigitalPin.P1, 0) // DC Command Mode\n        pins.digitalWritePin(DigitalPin.P16, 0) // CS Active\n        pins.spiWrite(command)\n        pins.digitalWritePin(DigitalPin.P1, 1) // DC Data Mode\n        for (let item of parameter) {\n            pins.spiWrite(item)\n        }\n        pins.digitalWritePin(DigitalPin.P16, 1) // CS Idle\n    }\n\n    function setWindow(x0: number, y0: number, x1: number, y1: number): void {\n        send(TFTCommands.CASET, [0x00, x0, 0x00, x1])\n        send(TFTCommands.RASET, [0x00, y0, 0x00, y1])\n    }\n\n    function enterDataMode(): void {\n        pins.digitalWritePin(DigitalPin.P1, 0)\n        pins.digitalWritePin(DigitalPin.P16, 0)\n        pins.spiWrite(TFTCommands.RAMWR)\n        pins.digitalWritePin(DigitalPin.P1, 1)\n    }\n\n    function exitDataMode(): void {\n        pins.digitalWritePin(DigitalPin.P16, 1)\n        pins.digitalWritePin(DigitalPin.P1, 0)\n    }\n\n    //% block=\"Initialize TFT Display\"\n    //% weight=100\n    export function init(): void {\n        pins.spiFrequency(4000000)\n        send(TFTCommands.SWRESET, [])\n        basic.pause(150)\n        send(TFTCommands.SLPOUT, [])\n        basic.pause(150)\n        send(TFTCommands.FRMCTR1, [0x01, 0x2C, 0x2D])\n        send(TFTCommands.FRMCTR2, [0x01, 0x2C, 0x2D, 0x01, 0x2C, 0x2D])\n        send(TFTCommands.INVCTR, [0x07])\n        send(TFTCommands.PWCTR1, [0xA2, 0x02, 0x84])\n        send(TFTCommands.PWCTR2, [0x8A, 0x2A])\n        send(TFTCommands.PWCTR3, [0x0A, 0x00])\n        send(TFTCommands.PWCTR4, [0x8A, 0x2A])\n        send(TFTCommands.PWCTR5, [0x8A, 0xEE])\n        send(TFTCommands.VMCTR1, [0x0E])\n        send(TFTCommands.INVOFF, [])\n\n        // HARDWARE COLOR FIX: 0xC0 toggles standard RGB parameters to BGR panel lines\n        send(TFTCommands.MADCTL, [0xC0])\n\n        send(TFTCommands.COLMOD, [0x05])\n        send(TFTCommands.CASET, [0x00, 0x00, 0x00, 0x7F])\n        send(TFTCommands.RASET, [0x00, 0x00, 0x00, 0x9F])\n        send(TFTCommands.GMCTRP1, [0x02, 0x1C, 0x07, 0x12, 0x37, 0x32, 0x29, 0x2D, 0x29, 0x25, 0x2B, 0x39, 0x00, 0x01, 0x03, 0x10])\n        send(TFTCommands.GMCTRN1, [0x03, 0x1D, 0x07, 0x06, 0x2E, 0x2C, 0x29, 0x2D, 0x2E, 0x2E, 0x37, 0x3F, 0x00, 0x00, 0x02, 0x10])\n        send(TFTCommands.NORON, [])\n        send(TFTCommands.DISPON, [])\n    }\n\n    //% block=\"Draw single pixel at x:%x|y:%y with color:%color\"\n    //% x.min=0 x.max=127\n    //% y.min=0 y.max=159\n    //% weight=90\n    export function drawPixel(x: number, y: number, color: Color): void {\n        setWindow(x, y, x + 1, y + 1)\n        send(TFTCommands.RAMWR, [color >> 8, color])\n    }\n\n    //% block=\"Draw line from x0:%x0|y0:%y0 to x1:%x1|y:%y1 with color:%color\"\n    //% x0.min=0 x0.max=127\n    //% y0.min=0 y0.max=159\n    //% x1.min=0 x1.max=127\n    //% y1.min=0 y1.max=159\n    //% weight=85\n    export function drawLine(x0: number, y0: number, x1: number, y1: number, color: Color): void {\n        let xDelta = x1 - x0\n        let yDelta = y1 - y0\n        if (Math.abs(yDelta) > Math.abs(xDelta)) {\n            let ySteps = Math.abs(yDelta)\n            let xIncrement = xDelta == 0 ? 0 : xDelta / ySteps\n            let yIncrement = yDelta > 0 ? 1 : -1\n            let x = x0\n            let y = y0\n            for (let steps = 0; steps <= ySteps; steps++) {\n                drawPixel(x, y, color)\n                y = y + yIncrement\n                x = x + xIncrement\n            }\n        } else {\n            let xSteps = Math.abs(xDelta)\n            let yIncrement = yDelta == 0 ? 0 : yDelta / xSteps\n            let xIncrement = xDelta > 0 ? 1 : -1\n            let y = y0\n            let x = x0\n            for (let steps = 0; steps <= xSteps; steps++) {\n                drawPixel(x, y, color)\n                y = y + yIncrement\n                x = x + xIncrement\n            }\n        }\n    }\n\n    //% block=\"Draw rectangle at x:%x|y:%y with width:%width|height:%height|color:%color\"\n    //% x.min=0 x.max=127\n    //% y.min=0 y.max=159\n    //% weight=80\n    export function drawRectangle(x: number, y: number, width: number, height: number, color: Color): void {\n        let hiColor = (color >> 8) % 256\n        let loColor = color % 256\n        setWindow(x, y, x + width - 1, y + height - 1)\n        enterDataMode()\n        for (let indexY = height; indexY > 0; indexY--) {\n            for (let indexX = width; indexX > 0; indexX--) {\n                pins.spiWrite(hiColor);\n                pins.spiWrite(loColor);\n            }\n        }\n        exitDataMode()\n    }\n\n    //% block=\"Draw circle at: x:%x|y:%y with radius:%r and color:%color\"\n    //% x.min=0 x.max=127\n    //% y.min=0 y.max=159\n    //% weight=75\n    export function drawCircle(x: number, y: number, radius: number, color: Color): void {\n        for (let y1 = -radius; y1 <= 0; y1++) {\n            for (let x1 = -radius; x1 <= 0; x1++) {\n                if ((x1 * x1 + y1 * y1) <= (radius * radius)) {\n                    drawPixel(x + x1, y + y1, color)\n                    drawPixel(x + x1, y - y1, color)\n                    drawPixel(x - x1, y + y1, color)\n                    drawPixel(x - x1, y - y1, color)\n                }\n            }\n        }\n    }\n\n    //% block=\"Show string:%string at x:%x and y:%y with zoom-level:%zoom color:%color and background color:%bgcolor\"\n    //% weight=70\n    //% x.min=0 x.max=127\n    //% y.min=0 y.max=159\n    //% zoom.min=1 zoom.max=5\n    export function showString(text: string, x: number, y: number, zoom: number, color: Color, bgColor: Color): void {\n        let hiColor = (color >> 8) % 256\n        let loColor = color % 256\n        let bgHiColor = (bgColor >> 8) % 256\n        let bgLoColor = bgColor % 256\n        let zoomFactor = zoom\n        let index = 0\n        let colsel = 0\n        let unicode = 0\n        let charIndex = 0\n\n        for (let stringPos = 0; stringPos < text.length; stringPos++) {\n            charIndex = text.charCodeAt(stringPos)\n            if (charIndex < 20) { unicode = fontOne[charIndex] }\n            else if (charIndex < 40) { unicode = fontTwo[charIndex - 20] }\n            else if (charIndex < 60) { unicode = fontThree[charIndex - 40] }\n            else if (charIndex < 80) { unicode = fontFour[charIndex - 60] }\n            else if (charIndex < 100) { unicode = fontFive[charIndex - 80] }\n            else if (charIndex < 120) { unicode = fontSix[charIndex - 100] }\n            else if (charIndex < 140) { unicode = fontSeven[charIndex - 120] }\n\n            setWindow(x + stringPos * 5 * zoomFactor, y, x + stringPos * 5 * zoomFactor + 5 * zoomFactor - 1, y + 5 * zoomFactor - 1)\n            enterDataMode()\n\n            for (let indexY = 0; indexY < 5; indexY++) {\n                for (let a = 0; a < zoomFactor; a++) {\n                    for (let indexX = 0; indexX < 5; indexX++) {\n                        index = indexY + indexX * 5\n                        colsel = (unicode & (1 << index))\n                        for (let b = 0; b < zoomFactor; b++) {\n                            if (colsel) {\n                                pins.spiWrite(hiColor);\n                                pins.spiWrite(loColor);\n                            } else {\n                                pins.spiWrite(bgHiColor);\n                                pins.spiWrite(bgLoColor);\n                            }\n                        }\n                    }\n                }\n            }\n            exitDataMode();\n        }\n    }\n\n    //% block=\"Clear screen with color %color\"\n    //% weight=65\n    export function clearScreen(color: Color): void {\n        drawRectangle(0, 0, TFTWIDTH, TFTHEIGHT, color)\n    }\n\n    //% block=\"Turn display off\"\n    //% weight=60\n    export function turnOff(): void {\n        send(TFTCommands.DISPOFF, [])\n    }\n\n    //% block=\"Turn display on\"\n    //% weight=55\n    export function turnOn(): void {\n        send(TFTCommands.DISPON, [])\n    }\n}\n"}]}],"snapshots":[{"timestamp":1792313923814,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"Untitled\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}}],"shares":[],"lastSaveTime":1792314004601}